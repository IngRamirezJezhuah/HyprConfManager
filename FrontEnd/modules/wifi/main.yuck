(defwidget wifi-view []
  (box :orientation "v" :space-evenly false :class "view-container"
    (box :orientation "v" :space-evenly false :class "view-container"
      (label :text "Inalambrica" :class "view-title" :halign "start"))

    (box :class "card" :orientation "h" :space-evenly false
      (label :text {wifi_data.connected ? "󱚼" : "󱚽"} :class "card-icon")
      (box :orientation "v" :halign "start" :hexpand true
        (label :text {wifi_data.ssid} :class "card-title" :halign "start")
        (label :text "Conectado" :class "card-subtitle" :halign "start"))
      (label :text "${wifi_data.signal}%"))
  )
) 
